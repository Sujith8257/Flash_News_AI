# Groq API keys — each key is usually a separate org with its own RPM/TPM pools.
# Provide at least one of: GROQ_API_KEY, GROQ_API_KEYS, or per-role keys below.
GROQ_API_KEY=your_primary_groq_api_key_here

# Optional: multiple keys in order → research (0), fact-check (1), write (2), image curator (3) when role vars unset.
# GROQ_API_KEYS=key_research,key_fact,key_write,key_image
# Or newline-separated (4 lines for all four agents).

# Optional: one Groq key per Crew step (overrides GROQ_API_KEYS slot for that role).
# GROQ_API_KEY_RESEARCH=
# GROQ_API_KEY_FACT_CHECK=
# GROQ_API_KEY_VALIDATE=
# GROQ_API_KEY_WRITE=
# GROQ_API_KEY_IMAGE=

# If you see getaddrinfo failed / Errno 11001: fix Windows DNS (use 8.8.8.8 / 1.1.1.1),
# or set HTTPS_PROXY if behind a corporate proxy. Crew retries transient failures automatically.
# CREWAI_DISABLE_TELEMETRY=true is set by default in code to skip telemetry.crewai.com lookups.

# Groq: use different model IDs per role so TPM/RPM accrue in separate pools (per Groq rate-limit table).
# IDs: with or without groq/ prefix; openai/... → groq/openai/...
# Docs: https://console.groq.com/docs/rate-limits — caps: https://console.groq.com/settings/limits
#
# GROQ_MODEL_RESEARCH   — tools + JSON (default: llama-3.3-70b-versatile)
# GROQ_MODEL_FACT_CHECK — verification (alias GROQ_MODEL_VALIDATE; default: llama-3.1-8b-instant)
# GROQ_MODEL_IMAGE      — image plan JSON + optional fetch_image_candidates (default: llama-3.1-8b-instant)
# GROQ_MODEL_WRITE      — long article (default: meta-llama/llama-4-scout-17b-16e-instruct)
#
# GROQ_MODEL applies to ALL roles only when none of the GROQ_MODEL_* vars below are set (single-model mode).
GROQ_MODEL_RESEARCH=llama-3.3-70b-versatile
GROQ_MODEL_FACT_CHECK=llama-3.1-8b-instant
GROQ_MODEL_IMAGE=llama-3.1-8b-instant
GROQ_MODEL_WRITE=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_MODEL=llama-3.3-70b-versatile
#
GROQ_MAX_TOKENS=8192
# Optional per-role output caps (defaults scale from GROQ_MAX_TOKENS if omitted)
# GROQ_MAX_TOKENS_RESEARCH=6144
# GROQ_MAX_TOKENS_FACT_CHECK=4096
# GROQ_MAX_TOKENS_IMAGE=3072
# GROQ_MAX_TOKENS_WRITE=8192
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Flask Environment
FLASK_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Port (usually set by hosting platform)
PORT=5000

# Supabase Configuration (Optional - for database storage)
# Get these from your Supabase project settings: https://app.supabase.com
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-key-here
# SUPABASE_STORAGE_ENABLED=true  # Set to false to use file storage only

